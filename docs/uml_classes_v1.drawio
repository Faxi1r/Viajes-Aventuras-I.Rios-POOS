        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction LR\n\n    class Usuario {\n        -idUsuario: Integer\n        -nombre: String\n        -correo: String\n        -contrasenaHash: String\n        -rol: String\n        +consultarHistorialReservas(): List\n    }\n\n    class Destino {\n        -idDestino: Integer\n        -nombre: String\n        -descripcion: String\n        -ubicacion: String\n        -estado: String\n        +registrar(): Boolean\n        +modificar(): Boolean\n        +eliminar(): Boolean\n        +listarDisponibles(): List\n    }\n\n    class PaqueteTuristico {\n        -idPaquete: Integer\n        -nombre: String\n        -descripcion: String\n        -fechaInicio: Date\n        -fechaFin: Date\n        -disponible: Boolean\n        +crear(): Boolean\n        +agregarDestino(destino: Destino): Boolean\n        +definirFechas(inicio: Date, fin: Date): Boolean\n        +calcularCosto(): Decimal\n        +consultarDisponibilidad(): Boolean\n    }\n\n    class PaqueteDestino {\n        -costoAsociado: Decimal\n        +obtenerCosto(): Decimal\n    }\n\n    class Reserva {\n        -idReserva: Integer\n        -fechaReserva: Date\n        -cantidadPersonas: Integer\n        -precioTotal: Decimal\n        -estado: String\n        +crearReserva(): Boolean\n        +guardarReserva(): Boolean\n    }\n\n    class ServicioAutenticacion {\n        +registrarUsuario(usuario: Usuario): Boolean\n        +iniciarSesion(correo: String, contrasena: String): Boolean\n        +verificarCredenciales(correo: String, contrasena: String): Boolean\n    }\n\n    class ValidadorDatos {\n        +validarUsuario(usuario: Usuario): Boolean\n        +validarDestino(destino: Destino): Boolean\n        +validarPaquete(paquete: PaqueteTuristico): Boolean\n        +validarReserva(reserva: Reserva): Boolean\n    }\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reserva : realiza\n    PaqueteTuristico \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Reserva : recibe\n\n    PaqueteTuristico \&quot;1\&quot; *-- \&quot;2..*\&quot; PaqueteDestino : contiene\n    Destino \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PaqueteDestino : se incluye en\n\n    ServicioAutenticacion ..&gt; Usuario : autentica\n    ServicioAutenticacion ..&gt; ValidadorDatos : valida credenciales\n\n    ValidadorDatos ..&gt; Usuario : valida\n    ValidadorDatos ..&gt; Destino : valida\n    ValidadorDatos ..&gt; PaqueteTuristico : valida\n    ValidadorDatos ..&gt; Reserva : valida\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rznbDENigE6htsy2vIMo-1">
